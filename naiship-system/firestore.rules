rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function getUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return getUser().role == 'admin'; }
    function isManager() { return getUser().role in ['admin', 'manager']; }
    function isSameRegion(companyId) { return isSignedIn(); }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || isManager() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin() || (isSignedIn() && (request.auth.uid == userId || resource.data.email == request.auth.token.email));
      match /compClosingBalances/{month} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isManager() || (isSignedIn() && request.auth.uid == userId);
      }
      match /compAdjustments/{adjustmentId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /cases/{caseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isSameRegion(request.resource.data.companyId);
      allow update: if isSignedIn() && isSameRegion(resource.data.companyId);
      allow delete: if isAdmin();
      match /{subcollection}/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isSameRegion(request.resource.data.companyId);
      allow update: if isSameRegion(resource.data.companyId) && (
        isManager() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedCaseIds', 'linkedCaseId'])
      );
      allow delete: if isAdmin();
      match /notes/{noteId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
      match /contactLogs/{logId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }
    match /workLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isSameRegion(request.resource.data.companyId);
      allow update: if isSignedIn() && isSameRegion(resource.data.companyId);
      allow delete: if isManager() && isSameRegion(resource.data.companyId);
      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }
    match /leaveRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isSameRegion(request.resource.data.companyId);
      allow update, delete: if isManager() && isSameRegion(resource.data.companyId);
    }
    match /calendarEvents/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isSameRegion(request.resource.data.companyId);
      allow update, delete: if isSignedIn() && isSameRegion(resource.data.companyId);
    }
    match /vendors/{vendorId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isManager();
    }
    match /todos/{todoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }
    match /quotations/{docId} {
      allow read, write: if isSignedIn();
    }
    match /caseGroupOverrides/{groupId} {
      allow read, write: if isSignedIn();
    }
    match /activityLog/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
    match /notifications/{notifId} {
      allow read, delete, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update: if isManager();
      allow delete: if isManager();
    }
    match /paymentReminders/{reminderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isManager() || (resource != null && resource.data.source == 'auto');
    }
    match /dashboardNotes/{noteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
    match /pettyCash/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /leaveRecords/{docId} {
      allow read, write: if isAdmin();
    }
    match /caseBonusData/{caseId} {
      allow read, write: if isAdmin();
    }
    match /bonusQuarters/{quarterId} {
      allow read, write: if isAdmin();
    }
  }
}
